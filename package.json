{
  "name": "accessgo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "fetch:osm": "node scripts/fetch-osm.ts",
    "check:ai": "node --env-file-if-exists=.env scripts/check-gemma.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
