# Tutte le chiavi sono lette SOLO dal server (mai dal bundle frontend).

# Routing per sedia a rotelle — tutto gratuito.
# Senza chiave: Valhalla (istanza pubblica FOSSGIS, profilo "wheelchair"), nessuna registrazione.
# Facoltativo: OpenRouteService (profilo "wheelchair", considera anche i cordoli). Chiave gratuita:
# https://openrouteservice.org/dev/#/signup  — se ORS non risponde si usa Valhalla.
ORS_API_KEY=

# Gemma via Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# In alternativa: Gemma in locale con Ollama (es. `ollama pull gemma3`). Ha priorità su Google AI Studio se impostato.
OLLAMA_URL=
OLLAMA_MODEL=

# ElevenLabs — dettatura e guida vocale (https://elevenlabs.io/, piano gratuito).
# Basta una chiave con i soli permessi "text to speech" e "speech to text". Se vuota: voce disattivata.
ELEVENLABS_API_KEY=
# Voce (default: George, voce standard) e modello di sintesi
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Token per l'azione moderatore (cambio stato segnalazioni). Se vuoto, la modifica degli stati è disabilitata.
# Usa un valore lungo e casuale, per esempio: node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Porta del server in produzione (npm start)
PORT=8787
